---
import '/src/styles/bootstrap.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo.svg';
import favicon from '../assets/favicon.ico';

const {
  title = 'Astro with Bootstrap by Saaqi',
  description = 'This template should help get you started developing with Astro with bootstrap.',
  ...attrs
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href="./sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="d-flex flex-column min-vh-100" data-bs-theme="dark">
    <header>
      <Navigation />
    </header>
    <main {...attrs}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
