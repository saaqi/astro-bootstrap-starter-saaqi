---
import { Image } from 'astro:assets';
import Logo from '../assets/logo.svg';

interface NavLinks {
  name: string;
  href: string;
}

const navLinks: NavLinks[] = [
  {
    name: 'Home',
    href: '/astro-bootstrap-starter-saaqi'
  },
  {
    name: 'Blog',
    href: '/astro-bootstrap-starter-saaqi/blog'
  }
];
---

<nav class="navbar navbar-expand-lg bg-primary-subtle">
  <div class="container gap-2 py-2">
    <a href="/astro-bootstrap-starter-saaqi" class="logo">
      <Image src={Logo} class="img-fluid navLogo" alt="Logo" />
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse ms-lg-5" id="navbarNav">
      <ul class="navbar-nav w-100 my-lg-0 my-3 gap-3">
        {
          navLinks.map((link) => {
            return (
              <li class="nav-item my-lg-0 my-2 h5 text-uppercase rounded-3 bg-secondary-subtle">
                <a class="nav-link py-2 px-3" href={link.href}>
                  {link.name}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  import 'bootstrap/js/dist/collapse.js';
</script>

<style>
  .navLogo {
    width: 80px;
    height: auto;
  }
  .navSpacer {
    min-height: 80px;
  }
</style>
