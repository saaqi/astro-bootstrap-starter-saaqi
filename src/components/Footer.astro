---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
---

<footer class="py-3 mt-auto bg-primary">
  <div class="container">
    <div class="row align-items-center justify-content-between">
      <Image class="img-fluid my-3 col" src={logo} alt="Astro with Bootstrap by Saaqi" />
      <div class="credits col text-end">
        Created and maintained by
        <a href="https://saqibtech.com" target="_blank" title="Saqib Islam - UI/UX Desginer & Full Stack Developer">
          Saaqi
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .img-fluid {
    max-width: 150px;
  }
</style>
